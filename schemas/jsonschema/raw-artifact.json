{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://tinlance.com/world-intelligence/schemas/raw-artifact.schema.json",
  "title":"World Intelligence Raw Artifact",
  "type":"object",
  "additionalProperties":false,
  "required":["artifact_id","content_sha256","size_bytes","storage_uri","source_id","retrieved_at"],
  "properties":{
    "artifact_id":{"type":"string","minLength":1},
    "content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "size_bytes":{"type":"integer","minimum":0},
    "media_type":{"type":["string","null"]},
    "content_encoding":{"type":["string","null"]},
    "storage_uri":{"type":"string","minLength":1},
    "source_id":{"type":"string","minLength":1},
    "retrieved_at":{"type":"string","format":"date-time"},
    "etag":{"type":["string","null"]},
    "last_modified":{"type":["string","null"]},
    "acquisition_version":{"type":"string","minLength":1}
  }
}
